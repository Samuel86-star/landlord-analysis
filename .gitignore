# macOS 系统文件
.DS_Store

# Claude Code 本地配置
.claude/settings.local.json

# 本地环境配置（每台机器不同，不提交到仓库）
CLAUDE.local.md

# 临时工作区（脚本执行生成的临时 SQL、草稿等，不提交到仓库）
py/tmp/

# Python 字节码缓存
__pycache__/
*.pyc

# 调度器运行日志（每天每张表的 stdout/stderr，不提交）
py/logs/

# 分析产出（每次跑会重生成，CSV 在 output/，不提交）
py/first-classic-beginner/output/
