# macOS 系统文件
.DS_Store

# Claude Code 本地配置
.claude/settings.local.json

# 本地 Git worktree
.worktrees/

# 本地环境配置（每台机器不同，不提交到仓库）
CLAUDE.local.md

# 临时工作区（脚本执行生成的临时 SQL、草稿等，不提交到仓库）
ops/py/tmp/

# Python 字节码缓存
__pycache__/
*.pyc

# 调度器运行日志（每天每张表的 stdout/stderr，不提交）
ops/py/logs/

# 分析产出（每次跑会重生成，CSV 在 output/，不提交）
ops/py/first-classic-beginner/output/

# algorithm 只读快照：防止在 analysis 内构建产生的产物误提交
algorithm/target/
algorithm/native/build/
algorithm/native/sampler
algorithm/native/test_main
